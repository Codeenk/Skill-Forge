{
  "registries": [
    {
      "name": "agentskills.io",
      "type": "npx",
      "command": "npx --yes skills find",
      "trusted": true,
      "description": "Standard Agent Skills registry"
    },
    {
      "name": "github-topics",
      "type": "github",
      "query": "https://api.github.com/search/repositories?q=topic:agent-skills+{query}&per_page=5",
      "trusted": "verify",
      "description": "GitHub repositories with topic #agent-skills"
    },
    {
      "name": "vendor-allowlist",
      "type": "allowlist",
      "trusted": true,
      "vendors": [
        "anthropics/skills",
        "vercel/skills",
        "opencode/skills",
        "onmax/stripe-billing-skill",
        "supabase/auth-skill"
      ]
    }
  ],
  "policy": {
    "default_scope": ".forge/vendor",
    "global_requires_flag": "--global",
    "audit_required": true,
    "auto_install_without_consent": false,
    "offline_flag": "--offline"
  }
}
